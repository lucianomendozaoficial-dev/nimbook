{
  "name": "Zuma — tu red social",
  "short_name": "Zuma",
  "description": "Comparte momentos, historias y mensajes con las personas que quieres.",
  "lang": "es",
  "dir": "ltr",
  "id": "/nimbook/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F0F2F5",
  "theme_color": "#0B6BFF",
  "categories": ["social", "communication", "lifestyle"],
  "icons": [
    { "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/logo/zuma-logo-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "assets/logo/zuma-logo-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/logo/zuma-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Inicio",
      "short_name": "Inicio",
      "url": "./index.html#/inicio",
      "icons": [{ "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Shop",
      "short_name": "Shop",
      "url": "./index.html#/tienda",
      "icons": [{ "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Historias",
      "short_name": "Historias",
      "url": "./index.html#/historias",
      "icons": [{ "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mensajes",
      "short_name": "Mensajes",
      "url": "./index.html#/mensajes",
      "icons": [{ "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mi perfil",
      "short_name": "Perfil",
      "url": "./index.html#/menu",
      "icons": [{ "src": "assets/logo/zuma-logo-192.png", "sizes": "192x192" }]
    }
  ]
}
